---
import { Icon } from '@astrojs/starlight/components';
---

<section
  class="oidfed-feature not-content print:hidden"
  aria-labelledby="oidfed-title"
  data-pagefind-ignore
>
  <div class="feature-copy">
    <h2 id="oidfed-title">Trust infrastructure for OpenID4VCI, OpenID4VP, and OpenID Connect</h2>
    <p>
      Establish trust between credential issuers, wallet providers, and verifiers,
      or between OpenID Providers and Relying Parties. Use <strong>oidfed</strong>’s
      JavaScript and TypeScript libraries to discover participants, validate trust
      chains, and apply metadata policies through OpenID Federation.
    </p>
    <p class="attribution">Another open-source project by this site’s maintainer.</p>
  </div>
  <div class="feature-links">
    <a href="https://github.com/Dahkenangnon/oidfed?utm_source=oidc-provider.dev">
      Explore oidfed on GitHub <Icon name="external" size="1rem" />
    </a>
    <a class="website-link" href="https://oidfed.com/?utm_source=oidc-provider.dev">
      Visit website <Icon name="external" size="1rem" />
    </a>
  </div>
</section>

<style>
  .oidfed-feature {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem 2rem;
    margin-block: 0 3rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--sl-color-accent);
    border-radius: 0.75rem;
    background-color: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
  }

  .feature-copy {
    flex: 1 1 30rem;
  }

  .feature-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  h2 {
    margin: 0;
    color: inherit;
    font-size: clamp(1.375rem, 2.5vw, 1.75rem);
    line-height: 1.25;
    text-wrap: balance;
  }

  p {
    max-width: 65ch;
    margin: 0.75rem 0 0;
    line-height: 1.6;
  }

  .attribution {
    font-size: 0.8125rem;
  }

  a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    border-radius: 0.375rem;
    background-color: var(--sl-color-accent-high);
    color: var(--sl-color-accent-low);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .website-link {
    background-color: transparent;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media print {
    .oidfed-feature {
      display: none;
    }
  }
</style>
