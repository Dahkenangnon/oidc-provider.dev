---
import Default from '@astrojs/starlight/components/Header.astro';
import { Icon } from '@astrojs/starlight/components';
---

<div class="site-navigation">
  <Default><slot /></Default>
</div>

<oidfed-promotion class="oidfed-promotion print:hidden" data-pagefind-ignore>
  <p>
    <span>From this site’s maintainer:</span>
    <strong>oidfed</strong> — Trust infrastructure for OpenID4VCI, OpenID4VP, and OpenID Connect.
  </p>
  <div class="promotion-links">
    <a href="https://github.com/Dahkenangnon/oidfed?utm_source=oidc-provider.dev">
      Explore on GitHub <Icon name="external" size="0.875rem" />
    </a>
    <a href="https://oidfed.com/?utm_source=oidc-provider.dev">
      Visit website <Icon name="external" size="0.875rem" />
    </a>
  </div>
</oidfed-promotion>

<script>
  class OidfedPromotion extends HTMLElement {
    observer?: ResizeObserver;

    connectedCallback() {
      const updateHeight = () => {
        document.documentElement.style.setProperty(
          '--oidfed-promo-height',
          `${this.getBoundingClientRect().height}px`,
        );
      };
      updateHeight();
      this.observer = new ResizeObserver(updateHeight);
      this.observer.observe(this);
    }

    disconnectedCallback() {
      this.observer?.disconnect();
    }
  }

  if (!customElements.get('oidfed-promotion')) {
    customElements.define('oidfed-promotion', OidfedPromotion);
  }
</script>

<style>
  .site-navigation {
    /* Keep the existing navigation and logo at their original height. */
    --sl-nav-height: var(--oidc-navigation-height);
    height: calc(var(--oidc-navigation-height) - 2 * var(--sl-nav-pad-y));
  }

  .oidfed-promotion {
    position: fixed;
    inset-block-start: var(--oidc-navigation-height);
    inset-inline: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    padding: 0.625rem var(--sl-nav-pad-x);
    border-bottom: 1px solid var(--sl-color-accent);
    background-color: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
    font-size: 0.8125rem;
    line-height: 1.5;
    text-align: center;
  }

  p {
    margin: 0;
    text-wrap: pretty;
  }

  strong {
    margin-inline-start: 0.25em;
  }

  .promotion-links {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }

  a {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: inherit;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  a:hover {
    text-decoration-thickness: 2px;
  }

  @media print {
    .oidfed-promotion {
      display: none;
    }
  }
</style>
